<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RosettaRpc</RootNamespace>

    <IsPackable>true</IsPackable>
    <PackageId>GodotRosettaRpc</PackageId>
    <Version>0.1.0</Version>
    <Authors>acamadeo</Authors>
    <Description>C# runtime (RpcMethodDescriptor, ServiceRegistry, RpcClient) for the godot-rosetta-rpc cross-language RPC framework.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/acamadeo/godot-rosetta-rpc</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host project supplies the real GodotSharp assembly at runtime via
         its own Godot.NET.Sdk project. -->
    <PackageReference Include="GodotSharp" Version="4.6.3" ExcludeAssets="runtime" />
    <!-- Keep in sync with PROTOC_VERSION in ci.yml: protoc 32.1 -->
    <PackageReference Include="Google.Protobuf" Version="3.32.1" />
  </ItemGroup>

</Project>
